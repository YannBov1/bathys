extends "res://Tests/RouteDrag.gd"

func click_at(at: Vector2) -> void:
	var press := InputEventMouseButton.new()
	press.button_index = MOUSE_BUTTON_LEFT
	press.position = at
	press.global_position = at
	press.pressed = true
	Input.parse_input_event(press)
	await layout()
	await release_drag(at)

func run() -> void:
	root.size = Vector2i(1280, 1400)
	var app: Control = load("res://Main.tscn").instantiate()
	root.add_child(app)
	app.acknowledge_educational_use()
	await settle(app)
	app.plan = BathysPlan.example(app.site)
	app.plan["waypoints"] = [app.plan["waypoints"][0], BathysPlan.hold("Hold", 30), BathysPlan.gas_switch("stage", "Switch")]
	BathysPlan.anchor_holds(app.plan, app.site)
	app.refresh_all()
	app.request_simulation()
	await settle(app)
	var original: Array = ids(app)
	var card: Control = app.route_list.get_node("Route_0")
	check(card.find_child("DragHandle", true, false) == null, "event card has no drag handle")
	var surfaces: Array[Control] = [card.find_child("EventTypeIcon", true, false), card.find_child("name", true, false), card.get_child(0).get_child(1)]
	for surface: Control in surfaces:
		await begin_drag(surface)
		check(app.route_drag_id == original[0], "icon, collapsed name and summary are draggable: " + surface.get_class())
		await move_drag(app.map.get_global_rect().get_center())
		await release_drag(app.map.get_global_rect().get_center())
	await begin_drag(card, card.get_global_rect().position + Vector2(3, 3))
	check(app.route_drag_id == original[0], "card padding is draggable")
	await move_drag(app.map.get_global_rect().get_center())
	await release_drag(app.map.get_global_rect().get_center())
	var edit: Button = card.find_child("EditorToggle", true, false)
	await click_at(edit.get_global_rect().get_center())
	var details: Control = card.find_child("InlineEditor", true, false)
	check(details.visible, "edit button still opens the editor normally")
	var name_input: LineEdit = card.find_child("name", true, false)
	name_input.grab_focus()
	name_input.select_all()
	await begin_drag(name_input, name_input.get_global_rect().position + Vector2(10, 14))
	check(app.route_drag_id.is_empty() and root.gui_get_drag_data() is String, "editable name keeps native text dragging instead of moving the card")
	await move_drag(app.map.get_global_rect().get_center())
	await release_drag(app.map.get_global_rect().get_center())
	var hold_card: Control = app.route_list.get_node("Route_1")
	var hold_edit: Button = hold_card.find_child("EditorToggle", true, false)
	await click_at(hold_edit.get_global_rect().get_center())
	var hold_name: LineEdit = hold_card.find_child("name", true, false)
	name_input.grab_focus()
	name_input.select_all()
	await begin_drag(name_input, name_input.get_global_rect().position + Vector2(10, 14))
	var text_drop_at: Vector2 = hold_name.get_global_rect().position + Vector2(15, 14)
	await move_drag(text_drop_at)
	await release_drag(text_drop_at)
	check(hold_name.text.contains("Tribute") and app.route_drag_id.is_empty(), "editable fields retain native text drop behavior")
	hold_name.text = "Hold"
	await click_at(hold_edit.get_global_rect().get_center())
	var sac: SpinBox = details.find_child("sacLPerMin", true, false)
	await begin_drag(sac.get_line_edit(), sac.get_line_edit().get_global_rect().position + Vector2(9, 12))
	check(app.route_drag_id.is_empty(), "numeric input gestures never start a route drag")
	await move_drag(app.map.get_global_rect().get_center())
	await release_drag(app.map.get_global_rect().get_center())
	var before: float = sac.value
	await click_at(Vector2(sac.get_global_rect().end.x - 6, sac.get_global_rect().position.y + 5))
	check(sac.value > before, "numeric spin arrows remain usable")
	await begin_drag(edit)
	check(app.route_drag_id.is_empty(), "dragging on a button never drags its card")
	await move_drag(app.map.get_global_rect().get_center())
	await release_drag(app.map.get_global_rect().get_center())
	var caption: Control = (details.find_child("targetDepthM", true, false) as SpinBox).get_parent().get_child(0)
	await begin_drag(caption)
	check(app.route_drag_id == original[0], "non-editable labels inside an open editor can drag the card")
	await move_drag(app.map.get_global_rect().get_center())
	await release_drag(app.map.get_global_rect().get_center())
	await click_at(edit.get_global_rect().get_center())
	check(not details.visible, "validate button still closes the editor")
	await settle(app)
	var switch_card: Control = app.route_list.get_node("Route_2")
	var switch_edit: Button = switch_card.find_child("EditorToggle", true, false)
	await click_at(switch_edit.get_global_rect().get_center())
	var selector: OptionButton = switch_card.find_child("tankId", true, false)
	await click_at(selector.get_global_rect().get_center())
	check(selector.get_popup().visible and app.route_drag_id.is_empty(), "gas selector opens normally without reordering")
	selector.get_popup().hide()
	check(ids(app) == original, "using controls and cancelled drags preserves event order")
	print("CARD_INPUT_CHECKS failures=", failures)
	app.queue_free()
	await process_frame
	quit(0 if failures == 0 else 1)
