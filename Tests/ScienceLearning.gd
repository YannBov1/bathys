extends "res://Tests/LearningUi.gd"

func near(actual: float, expected: float, tolerance: float, message: String) -> void:
	check(absf(actual - expected) <= tolerance, message + " (" + str(actual) + ")")

func run() -> void:
	root.size = Vector2i(1280, 1000)
	var localization := root.get_node("I18n")
	localization.set_language("en", false)
	var app: Control = load("res://Main.tscn").instantiate()
	root.add_child(app)
	await settle(app)
	var original: String = JSON.stringify(app.plan)
	app.set_learning_mode(true)
	await layout()
	var view: BathysLearningView = app.learning_view
	await click((view.topic_buttons["dalton"] as Button).get_global_rect().get_center())
	check(view.lesson == "dalton" and view.readouts.columns == 4, "Dalton opens from topic navigation with four pressure readouts")
	view.slider.value = 20
	var pressure: Dictionary = BathysLearningModels.partial_pressures(20, 21, 0)
	near(float(pressure["o2"]), 0.63, 1e-10, "air at 20 m has 0.63 bar oxygen")
	near(float(pressure["n2"]), 2.37, 1e-10, "air at 20 m has 2.37 bar nitrogen")
	check(view.readout_values[0].text == "3.00 bar" and view.readout_values[1].text == "0.63 bar", "Dalton readouts match the selected depth and mixture")
	await click((view.extra_controls["mixtures"] as Control).get_child(2).get_global_rect().get_center())
	check(view.oxygen_percent == 18 and view.helium_percent == 45, "trimix preset updates both mixture controls")
	pressure = BathysLearningModels.partial_pressures(view.dalton_depth, view.oxygen_percent, view.helium_percent)
	near(float(pressure["o2"]) + float(pressure["n2"]) + float(pressure["he"]), float(pressure["total"]), 1e-10, "partial pressures sum to total pressure for trimix")
	await capture("res://Screenshots/learning-dalton-en.png")
	(view.extra_sliders["oxygen"] as HSlider).value = 90
	check(view.oxygen_percent == 90 and view.helium_percent == 10, "oxygen adjustment keeps gas fractions valid")
	(view.extra_sliders["helium"] as HSlider).value = 80
	check(view.oxygen_percent == 20 and view.helium_percent == 80, "helium adjustment keeps gas fractions valid")
	await click(view.diagram.global_position + Vector2(view.diagram.size.x * 0.8, 64 + (view.diagram.size.y - 138) * 0.4))
	near(view.dalton_depth, 20, 0.1, "dragging pressure bars controls depth")
	await click((view.topic_buttons["henry"] as Button).get_global_rect().get_center())
	check(view.lesson == "henry" and view.readouts.columns == 3 and not view.extra_controls["oxygen"].visible, "Henry shows its own exchange controls")
	near(BathysLearningModels.equilibrium(4), 4, 1e-10, "fourfold gas pressure gives fourfold equilibrium concentration")
	near(BathysLearningModels.dissolved(4, 0), 1, 1e-10, "exchange starts at the fixed one-bar reference")
	near(BathysLearningModels.dissolved(4, 1), 2.5, 1e-10, "one half-time closes half the concentration gap")
	near(BathysLearningModels.dissolved(4, 2), 3.25, 1e-10, "two half-times close three quarters of the gap")
	near(BathysLearningModels.dissolved(0.5, 1), 0.75, 1e-10, "lower pressure gives gradual dissolved-gas release")
	await click((view.extra_controls["pressure_steps"] as Control).get_child(0).get_global_rect().get_center())
	check(view.gas_pressure == 4 and view.half_times == 0, "pressure-step preset resets elapsed time")
	(view.extra_sliders["time"] as HSlider).value = 1
	check(view.readout_values[1].text == "4.00 × ref." and view.readout_values[2].text == "2.50 × ref.", "Henry separates equilibrium target and current concentration")
	await capture("res://Screenshots/learning-henry-en.png")
	var plot: Rect2 = view.diagram.graph_rect("henry")
	await click(view.diagram.global_position + plot.position + Vector2(plot.size.x * 0.4, plot.size.y * 0.5))
	near(view.half_times, 2, 0.1, "curve input changes elapsed half-times")
	await click((view.extra_controls["pressure_steps"] as Control).get_child(1).get_global_rect().get_center())
	(view.extra_sliders["time"] as HSlider).value = 1
	check(view.gas_pressure == 0.5 and view.readout_values[2].text == "0.75 × ref.", "pressure-drop control illustrates off-gassing")
	await capture("res://Screenshots/learning-henry-release-en.png")
	await click((view.topic_buttons["density"] as Button).get_global_rect().get_center())
	check(view.lesson == "density" and view.extra_controls["salinity"].visible and not view.extra_controls["time"].visible, "water lesson shows temperature and salinity controls")
	var fresh: Dictionary = BathysLearningModels.water_properties(20, 0)
	var sea: Dictionary = BathysLearningModels.water_properties(20, 35)
	near(float(fresh["density"]), 998.2063, 0.0001, "freshwater density at 20°C matches EOS-80")
	near(float(sea["density"]), 1024.7630, 0.0001, "seawater density at 20°C matches EOS-80")
	near(float(BathysLearningModels.water_properties(0, 35)["density"]), 1028.1063, 0.0001, "seawater density at 0°C matches the UNESCO check value")
	near(float(fresh["metres_per_bar"]), 10.2155, 0.0001, "freshwater metres per bar use density and gravity")
	check(float(sea["metres_per_bar"]) < float(fresh["metres_per_bar"]), "denser seawater needs a shorter column for one bar")
	near(float(sea["pressure_at_10m"]) * float(sea["metres_per_bar"]), 10, 1e-10, "water pressure and metres per bar are reciprocal")
	var cold: float = float(BathysLearningModels.water_properties(0, 0)["density"])
	var peak: float = float(BathysLearningModels.water_properties(4, 0)["density"])
	check(peak > cold and peak > float(fresh["density"]), "freshwater density maximum near four degrees is represented")
	await capture("res://Screenshots/learning-density-en.png")
	await click((view.extra_controls["waters"] as Control).get_child(0).get_global_rect().get_center())
	check(view.temperature_c == 4 and view.salinity == 0 and view.readout_values[0].text == "999.97", "freshwater preset updates both controls and density")
	await capture("res://Screenshots/learning-density-fresh-en.png")
	plot = view.diagram.graph_rect("density")
	await click(view.diagram.global_position + plot.position + plot.size * 0.5)
	near(view.temperature_c, 17.5, 0.1, "dragging density curve updates temperature")
	(view.extra_sliders["salinity"] as HSlider).value = 40
	check(view.salinity == 40 and view.diagram.salinity == 40, "salinity slider updates density diagram")
	localization.set_language("fr", false)
	await layout()
	for topic: String in ["dalton", "henry", "density"]:
		view.select_lesson(topic)
		await layout()
		check(TranslationServer.translate(view.title_label.text) != view.title_label.text, "French heading for " + topic)
		check(TranslationServer.translate(view.assumptions_label.text) != view.assumptions_label.text, "French assumptions for " + topic)
		await capture("res://Screenshots/learning-" + topic + "-fr.png")
	root.size = Vector2i(390, 900)
	await layout()
	check(view.topic_picker.visible and not view.topic_stack.visible, "phone navigation uses a compact selector with categorized topics")
	for index: int in [2, 3, 4]:
		view.topic_picker.select(view.topic_picker.get_item_index(index))
		view.topic_picker.item_selected.emit(view.topic_picker.get_item_index(index))
		app.learning_view.lesson_scroll.scroll_vertical = 0
		await layout()
		check(view.get_combined_minimum_size().x <= 390, "French phone layout fits " + view.lesson)
		await capture("res://Screenshots/learning-" + view.lesson + "-fr-phone.png")
		app.learning_view.lesson_scroll.scroll_vertical = 10000
		await layout()
		await capture("res://Screenshots/learning-" + view.lesson + "-fr-phone-bottom.png")
	root.size = Vector2i(1280, 1000)
	await layout()
	view.select_lesson("dalton")
	check(view.oxygen_percent == 20 and view.helium_percent == 80 and view.dalton_depth == 20, "mixture experiment survives topic/language/size changes")
	view.select_lesson("henry")
	check(view.gas_pressure == 0.5 and view.half_times == 1, "Henry experiment survives topic changes")
	view.select_lesson("density")
	check(view.temperature_c == 17.5 and view.salinity == 40, "water experiment survives topic changes")
	app.set_learning_mode(false)
	await layout()
	check(JSON.stringify(app.plan) == original and app.undo_stack.is_empty(), "all three experiments leave the scenario and history unchanged")
	localization.set_language("en", false)
	app.queue_free()
	await layout()
	quit(1 if failures else 0)
